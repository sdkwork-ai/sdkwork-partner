# Rust
/target
Cargo.lock.orig

# Node / pnpm
node_modules/
dist/
.runtime/
*.tsbuildinfo
.vite/

# Generated SDK compiled outputs (only .ts sources are tracked)
**/generated/**/*.js
**/generated/**/*.d.ts
**/generated/**/*.js.map
**/generated/**/*.d.ts.map

# TypeScript/JavaScript build artifacts emitted alongside source (tsc declaration/emit)
*.d.ts.map
*.js.map

# SDKWork generator reports (local)
**/.sdkwork/sdkwork-generator-changes.json
**/.sdkwork/sdkwork-generator-manifest.json
**/.sdkwork/sdkwork-generator-report.json

# Editor / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log

# Local environment
.env
.env.local
.env.*.local

# Runtime-generated env config (modified by local dev server)
**/public/runtime-env.json

# Local scratch and build residue (do not commit)
tmp/
.tmp/

# Python bytecode (do not commit)
__pycache__/

# Local assistant state (do not commit)
.workbuddy/

# Compiler emit is ignored only where the file is emit BY DEFINITION. The broad
# `**/src/**/*.js` / `**/src/**/*.d.ts` globs are gone: `.gitignore` cannot express "ignore
# this only when a same-stem .ts sibling exists", so they also hid authored declarations
# (`vite-env.d.ts`, `styles.d.ts`, module shims) and real mini-program source under `src/`.
# The sibling rule is enforced against tracked files by
# `sdkwork-specs/tools/check-repository-baseline-content.mjs` instead.

# SDKWork generated/transpiled emit (build output, not committed)
# Added by repo-commit task 2026-09-25; targeted rules only, compliant with check-gitignore-standard
sdks/**/*-typescript/src/*.js
sdks/**/*-typescript/src/*.d.ts
