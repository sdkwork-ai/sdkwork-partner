# Rust
/target
Cargo.lock.orig

# Node / pnpm
node_modules/
dist/
.runtime/
*.tsbuildinfo
.vite/

# Generated SDK compiled outputs (only .ts sources are tracked)
**/generated/**/*.js
**/generated/**/*.d.ts
**/generated/**/*.js.map
**/generated/**/*.d.ts.map

# TypeScript/JavaScript build artifacts emitted alongside source (tsc declaration/emit)
*.d.ts.map
*.js.map
**/src/**/*.js
**/src/**/*.d.ts

# SDKWork generator reports (local)
**/.sdkwork/sdkwork-generator-changes.json
**/.sdkwork/sdkwork-generator-manifest.json
**/.sdkwork/sdkwork-generator-report.json

# Editor / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log

# Local environment
.env
.env.local
.env.*.local

# Runtime-generated env config (modified by local dev server)
**/public/runtime-env.json
