# cloud.demo — cloud-hosted independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL schema `sdkwork_partner_demo` (table
# prefix `partner_`) and a dedicated Redis logical DB index so no cache key collides with another
# shared-redis environment.
SDKWORK_PARTNER_DEPLOYMENT_PROFILE=cloud
SDKWORK_PARTNER_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_PARTNER_PROFILE_ID=cloud.demo
SDKWORK_PARTNER_APPLICATION_PUBLIC_HTTP_URL=https://partner-demo.sdkwork.com
SDKWORK_PARTNER_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com
