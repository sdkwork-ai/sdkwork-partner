# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL schema `sdkwork_partner_demo` (table
# prefix `partner_`) and a dedicated Redis logical DB index so that no cache key (rate-limit,
# session, idempotency) ever collides with another shared-redis environment.
SDKWORK_PARTNER_DEPLOYMENT_PROFILE=standalone
SDKWORK_PARTNER_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_PARTNER_PROFILE_ID=standalone.demo
SDKWORK_PARTNER_APPLICATION_PUBLIC_HTTP_URL=https://partner-demo.sdkwork.com
SDKWORK_PARTNER_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:3900


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_PARTNER_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
SDKWORK_CORS_ALLOWED_ORIGINS=https://partner-demo.sdkwork.com,http://partner-demo.sdkwork.com,https://partner-demo.birdcoder.com,http://partner-demo.birdcoder.com,https://partner-demo.dtupay.com,http://partner-demo.dtupay.com,https://partner-demo.noaper.com,http://partner-demo.noaper.com,https://partner-demo.sdkwork.cn,http://partner-demo.sdkwork.cn,https://partner-demo.birdcoder.cn,http://partner-demo.birdcoder.cn,https://partner-demo.dtupay.cn,http://partner-demo.dtupay.cn,https://partner-demo.noaper.cn,http://partner-demo.noaper.cn,https://partner-demo.skubc.com,http://partner-demo.skubc.com,https://partner-demo.skubc.cn,http://partner-demo.skubc.cn,https://partner-demo.zowalk.com,http://partner-demo.zowalk.com,https://partner-demo.zowalk.cn,http://partner-demo.zowalk.cn,https://partner-demo.offer86.com,http://partner-demo.offer86.com,https://partner-demo.offer86.cn,http://partner-demo.offer86.cn,https://partner-demo.86offer.com,http://partner-demo.86offer.com,https://partner-demo.86offer.cn,http://partner-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
