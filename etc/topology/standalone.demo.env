# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL schema `sdkwork_partner_demo` (table
# prefix `partner_`) and a dedicated Redis logical DB index so that no cache key (rate-limit,
# session, idempotency) ever collides with another shared-redis environment.
SDKWORK_PARTNER_DEPLOYMENT_PROFILE=standalone
SDKWORK_PARTNER_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_PARTNER_PROFILE_ID=standalone.demo
SDKWORK_PARTNER_APPLICATION_PUBLIC_HTTP_URL=https://partner-demo.sdkwork.com
SDKWORK_PARTNER_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:3900
